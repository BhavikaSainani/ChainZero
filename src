          <div style={{ marginTop: "16px", fontSize: "13px", color: COLOR.inkMuted, borderTop: `1px solid ${COLOR.hairline}`, paddingTop: "10px" }}>
            * Modelled projection applied to Scope 3 Category 4 upstream freight DEFRA tonne-km factors.
          </div>
        </div>
      </div>

      {/* Available Transition Benchmarks Catalog */}
      <div className="cad-panel" style={{ padding: "20px 24px" }}>
        <div style={{ fontSize: "15px", fontWeight: 700, color: COLOR.ink, marginBottom: "8px" }}>
          Supply Chain Decarbonization Alternatives Catalog (from dashboard.json)
        </div>
        <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(240px, 1fr))", gap: "14px", marginTop: "12px" }}>
          {(alternatives || []).map((alt, i) => (
            <div key={i} style={{ background: COLOR.cardBg, border: `1px solid ${COLOR.hairlineStrong}`, padding: "14px 16px", borderRadius: "4px" }}>
              <div style={{ fontSize: "13px", color: COLOR.inkMuted, fontWeight: 600 }}>Transition Pathway</div>
              <div style={{ fontSize: "14px", fontWeight: 700, color: COLOR.ink, marginTop: "4px" }}>
                {MATERIAL_LABEL[alt.from] || TRANSPORT_LABEL[alt.from] || alt.from} &rarr;{" "}
                <span style={{ color: COLOR.tealBright }}>{MATERIAL_LABEL[alt.to] || TRANSPORT_LABEL[alt.to] || alt.to}</span>
              </div>
              <div style={{ fontSize: "16px", fontWeight: 800, color: COLOR.rustBright, fontFamily: "'IBM Plex Mono', monospace", marginTop: "6px" }}>
                -{alt.reductionPct}% Abatement
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

