function SupplierLedger({ nodes, onSelectSupplier, selectedSupplierId }) {
  const [search, setSearch] = useState("");
  const [tierFilter, setTierFilter] = useState("all");
  const [imputedFilter, setImputedFilter] = useState("all");

  const filtered = useMemo(() => {
    return nodes.filter((n) => {
      if (tierFilter !== "all" && String(n.tier) !== tierFilter) return false;
      if (imputedFilter === "imputed" && !n.energyImputed) return false;
      if (imputedFilter === "reported" && n.energyImputed) return false;
      if (!search.trim()) return true;
      const q = search.toLowerCase();
      return (
        n.name.toLowerCase().includes(q) ||
        n.id.toLowerCase().includes(q) ||
        n.country.toLowerCase().includes(q) ||
        (n.material && n.material.toLowerCase().includes(q))
      );
    });
  }, [nodes, search, tierFilter, imputedFilter]);

  return (
    <div style={{ display: "flex", flexDirection: "column", height: "100%" }}>
      {/* Filter bar */}
      <div style={{ display: "flex", gap: "12px", alignItems: "center", flexWrap: "wrap", marginBottom: "16px" }}>
        <input
          type="text"
          placeholder="Filter 200 suppliers by name, ID, country..."
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          style={{
            padding: "8px 14px",
            fontSize: "14px",
            borderRadius: "4px",
            border: `1px solid ${COLOR.hairlineStrong}`,
            background: COLOR.cardBg,
            color: COLOR.ink,
            width: "300px",
          }}
        />

        <select
          value={tierFilter}
          onChange={(e) => setTierFilter(e.target.value)}
          style={{
            padding: "8px 12px",
            fontSize: "14px",
            borderRadius: "4px",
            border: `1px solid ${COLOR.hairlineStrong}`,
            background: COLOR.cardBg,
            color: COLOR.ink,
          }}
        >
          <option value="all">All Tiers (1–4)</option>
          <option value="1">Tier 1</option>
          <option value="2">Tier 2</option>
          <option value="3">Tier 3</option>
          <option value="4">Tier 4</option>
        </select>

        <select
          value={imputedFilter}
          onChange={(e) => setImputedFilter(e.target.value)}
          style={{
            padding: "8px 12px",
            fontSize: "14px",
            borderRadius: "4px",
            border: `1px solid ${COLOR.hairlineStrong}`,
            background: COLOR.cardBg,
            color: COLOR.ink,
          }}
        >
          <option value="all">All Data Qualities</option>
          <option value="reported">Reported Only</option>
          <option value="imputed">Imputed / Proxy Only</option>
        </select>

        <div style={{ marginLeft: "auto", fontSize: "14px", color: COLOR.inkMuted }}>
          Showing <strong>{filtered.length}</strong> of {nodes.length} suppliers
        </div>
      </div>

      {/* Table */}
      <div style={{ overflowY: "auto", flex: 1, border: `1px solid ${COLOR.hairline}`, borderRadius: "4px", background: COLOR.cardBg }}>
        <table style={{ width: "100%", borderCollapse: "collapse", textAlign: "left", fontSize: "14px" }}>
          <thead>
            <tr style={{ background: COLOR.panel, borderBottom: `2px solid ${COLOR.hairlineStrong}`, color: COLOR.ink }}>
              <th style={{ padding: "12px 14px" }}>ID</th>
              <th style={{ padding: "12px 14px" }}>Supplier Name</th>
              <th style={{ padding: "12px 14px" }}>Tier</th>
              <th style={{ padding: "12px 14px" }}>Country</th>
              <th style={{ padding: "12px 14px" }}>Material</th>
              <th style={{ padding: "12px 14px" }}>Spend (USD)</th>
              <th style={{ padding: "12px 14px" }}>Direct tCO2e</th>
              <th style={{ padding: "12px 14px" }}>Energy Status</th>
              <th style={{ padding: "12px 14px", textAlign: "right" }}>Action</th>
            </tr>
          </thead>
          <tbody>
            {filtered.map((r) => {
              const isSelected = selectedSupplierId === r.id;
              return (
                <tr
                  key={r.id}
                  onClick={() => onSelectSupplier(r.id)}
                  style={{
                    borderBottom: `1px solid ${COLOR.hairline}`,
                    background: isSelected ? "rgba(168,71,31,0.08)" : "transparent",
                    cursor: "pointer",
                    transition: "background 150ms ease",
                  }}
                >
                  <td style={{ padding: "12px 14px", fontFamily: "'IBM Plex Mono', monospace", fontWeight: 700, color: COLOR.ink }}>
                    {r.id}
                  </td>
                  <td style={{ padding: "12px 14px", fontWeight: 600, color: COLOR.ink }}>{r.name}</td>
                  <td style={{ padding: "12px 14px", color: COLOR.ink }}>Tier {r.tier}</td>
                  <td style={{ padding: "12px 14px", color: COLOR.ink }}>{r.country}</td>
                  <td style={{ padding: "12px 14px", color: COLOR.ink }}>
                    {MATERIAL_LABEL[r.material] || r.material}
                  </td>
                  <td style={{ padding: "12px 14px", fontFamily: "'IBM Plex Mono', monospace", color: COLOR.ink }}>
                    {formatCurrency(r.spendUsd)}
                  </td>
                  <td style={{ padding: "12px 14px", fontFamily: "'IBM Plex Mono', monospace", fontWeight: 700, color: COLOR.rust }}>
                    {formatDec(r.directTco2e)}
                  </td>
                  <td style={{ padding: "12px 14px" }}>
                    <span
                      style={{
                        fontSize: "12px",
                        fontWeight: 700,
                        padding: "3px 8px",
                        borderRadius: "3px",
                        background: r.energyImputed ? COLOR.amberLight : "rgba(45,125,100,0.12)",
                        color: r.energyImputed ? COLOR.rustBright : COLOR.tealBright,
                        border: `1px solid ${r.energyImputed ? COLOR.rust : COLOR.tealBright}`,
                      }}
                    >
                      {r.energyImputed ? "IMPUTED" : "REPORTED"}
                    </span>
                  </td>
                  <td style={{ padding: "12px 14px", textAlign: "right" }}>
                    <button
                      onClick={(e) => {
                        e.stopPropagation();
                        onSelectSupplier(r.id);
                      }}
                      style={{
                        fontSize: "13px",
                        fontWeight: 600,
                        padding: "5px 10px",
                        background: COLOR.ink,
                        color: COLOR.concrete,
                        border: "none",
                        borderRadius: "3px",
                        cursor: "pointer",
                      }}
                    >
                      Audit &rarr;
                    </button>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  );
}

