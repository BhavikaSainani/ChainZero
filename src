            {/* Metrics grid */}
            <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr 1fr", gap: "10px", background: COLOR.concreteDim, padding: "14px", borderRadius: "4px", textAlign: "center" }}>
              <div>
                <div style={{ fontSize: "13px", color: COLOR.inkMuted, fontWeight: 600 }}>Current</div>
                <div style={{ fontSize: "18px", fontWeight: 700, color: COLOR.ink, fontFamily: "'IBM Plex Mono', monospace", marginTop: "2px" }}>
                  {formatDec(transCurrentTonnes, 2)} t
                </div>
              </div>
              <div>
                <div style={{ fontSize: "13px", color: COLOR.inkMuted, fontWeight: 600 }}>Projected</div>
                <div style={{ fontSize: "18px", fontWeight: 700, color: COLOR.teal, fontFamily: "'IBM Plex Mono', monospace", marginTop: "2px" }}>
                  {formatDec(transProjectedTonnes, 2)} t
                </div>
              </div>
              <div>
                <div style={{ fontSize: "13px", color: COLOR.rustBright, fontWeight: 700 }}>Delta (Abated)</div>
                <div style={{ fontSize: "18px", fontWeight: 700, color: COLOR.rustBright, fontFamily: "'IBM Plex Mono', monospace", marginTop: "2px" }}>
                  -{formatDec(transDelta, 2)} t
