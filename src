/*  Section 3: Graph Readability at 200 Nodes                          */
/* ------------------------------------------------------------------ */

function MultiTierFlowVisualizer({ nodes, edges, onSelectSupplier, selectedSupplierId }) {
  const [searchQuery, setSearchQuery] = useState("");
  const [expandedTier3, setExpandedTier3] = useState({});
  const [expandAllT4, setExpandAllT4] = useState(false);

  // Group nodes by tier
  const tier1Nodes = useMemo(() => nodes.filter((n) => n.tier === 1), [nodes]);
  const tier2Nodes = useMemo(() => nodes.filter((n) => n.tier === 2), [nodes]);
  const tier3Nodes = useMemo(() => nodes.filter((n) => n.tier === 3), [nodes]);
  const tier4Nodes = useMemo(() => nodes.filter((n) => n.tier === 4), [nodes]);

  // Map Tier 4 nodes to their parent Tier 3 nodes
  const tier4ByParent = useMemo(() => {
    const map = {};
    const t4Set = new Set(tier4Nodes.map((n) => n.id));
    edges.forEach((e) => {
      if (t4Set.has(e.from)) {
        if (!map[e.to]) map[e.to] = [];
        const childNode = nodes.find((n) => n.id === e.from);
        if (childNode && !map[e.to].some((c) => c.id === childNode.id)) {
          map[e.to].push(childNode);
        }
      }
    });
    return map;
  }, [edges, tier4Nodes, nodes]);

  // Search filtering
  const q = searchQuery.trim().toLowerCase();
  const isMatch = (n) => {
    if (!q) return false;
    return (
      n.name.toLowerCase().includes(q) ||
      n.id.toLowerCase().includes(q) ||
      (n.material && n.material.toLowerCase().includes(q))
    );
  };

  const matchCount = useMemo(() => {
    if (!q) return 0;
    return nodes.filter(isMatch).length;
  }, [nodes, q]);

  // Node radius scaling with directTco2e
  function getNodeRadius(tco2e) {
    // sqrt scaling bounded between 6 and 22
    return Math.max(6, Math.min(22, Math.round(Math.sqrt(tco2e || 0) * 0.45 + 6)));
  }

  const toggleParentExpand = (parentId) => {
    setExpandedTier3((prev) => ({
      ...prev,
      [parentId]: !prev[parentId],
    }));
  };

  const toggleAllExpand = () => {
    const nextVal = !expandAllT4;
    setExpandAllT4(nextVal);
