function BlindSpotPanel({ blindSpot }) {
  if (!blindSpot) return null;

  const bsiPct = +(blindSpot.index * 100).toFixed(1);
  const lineCoveragePct = +(blindSpot.lineCoverage * 100).toFixed(1);

  // Parse byTier: keys "1", "2", "3", "4"
  const tierData = Object.entries(blindSpot.byTier || {}).map(([tierKey, val]) => {
    const tierBsi = +(val.bsi * 100).toFixed(1);
    return {
      tierLabel: `Tier ${tierKey}`,
      tier: tierKey,
      bsi: tierBsi,
      suppliers: val.suppliers,
      suppliersWithGaps: val.suppliers_with_gaps,
    };
  });

  // Identify worst tier (highest bsi)
  const maxBsi = Math.max(...tierData.map((t) => t.bsi), 0);

  return (
    <div
      style={{
        background: "#161513",
        border: `1px solid ${COLOR.rust}`,
        borderRadius: "6px",
        padding: "24px 28px",
        color: COLOR.concrete,
        marginTop: "20px",
        marginBottom: "24px",
      }}
    >
      <div style={{ display: "grid", gridTemplateColumns: "1.2fr 1fr", gap: "28px", alignItems: "center" }}>
        {/* Left Column: Big Percentage, Band, and Contrast Line */}
        <div>
          <div style={{ display: "flex", alignItems: "center", gap: "14px", flexWrap: "wrap" }}>
            <span style={{ fontSize: "14px", fontWeight: 700, letterSpacing: "0.08em", color: COLOR.rustBright, textTransform: "uppercase" }}>
              Scope 3 Assurance &middot; The Blind Spot Index
            </span>
            <span
              style={{
                fontSize: "14px",
                fontWeight: 700,
                padding: "4px 12px",
                borderRadius: "3px",
                background: COLOR.brick,
                color: "#FFF",
                textTransform: "uppercase",
              }}
            >
              Band: {blindSpot.band}
            </span>
          </div>

          <div style={{ display: "flex", alignItems: "baseline", gap: "16px", marginTop: "10px" }}>
            <div
              style={{
                fontSize: "clamp(36px, 5vw, 54px)",
                fontWeight: 800,
                fontFamily: "'IBM Plex Mono', monospace",
                color: COLOR.rustBright,
                lineHeight: 1,
              }}
            >
              {bsiPct}%
            </div>
            <div style={{ fontSize: "16px", color: COLOR.concreteDim, fontWeight: 500 }}>
              of procurement spend is unverified
            </div>
          </div>

          {/* Contrast Line */}
          <div
            style={{
              marginTop: "16px",
              padding: "14px 18px",
              background: "rgba(237,234,227,0.08)",
              borderLeft: `4px solid ${COLOR.rustBright}`,
              borderRadius: "0 4px 4px 0",
              fontSize: "15px",
              lineHeight: 1.5,
              color: COLOR.concrete,
            }}
          >
            <strong>Contrast Metric:</strong> Line item coverage reads{" "}
            <span style={{ color: COLOR.tealBright, fontWeight: 700 }}>{lineCoveragePct}%</span>, yet{" "}
            <span style={{ color: COLOR.rustBright, fontWeight: 700 }}>{bsiPct}%</span> of total supply chain spend runs through suppliers with unverified, missing, or proxy-estimated emission data.
          </div>
        </div>

        {/* Right Column: Bar Chart of byTier BSI values */}
        <div style={{ background: "rgba(33, 31, 27, 0.6)", padding: "18px 20px", borderRadius: "6px", border: `1px solid ${COLOR.hairlineOnDark}` }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "8px" }}>
            <span style={{ fontSize: "14px", fontWeight: 600, color: COLOR.concrete }}>
              Blind Spot Index by Tier (Worst Tier Highlighted)
            </span>
            <span style={{ fontSize: "13px", color: COLOR.concreteDim }}>
              Deep-tier data quality drop-off
            </span>
          </div>

          <div style={{ height: "160px", width: "100%" }}>
            <ResponsiveContainer width="100%" height="100%">
              <BarChart data={tierData} margin={{ top: 10, right: 15, left: -10, bottom: 0 }}>
                <CartesianGrid vertical={false} stroke="rgba(237,234,227,0.12)" />
                <XAxis dataKey="tierLabel" tick={{ fill: COLOR.concrete, fontSize: 13, fontFamily: "IBM Plex Sans" }} axisLine={{ stroke: "rgba(237,234,227,0.2)" }} />
                <YAxis unit="%" tick={{ fill: COLOR.concreteDim, fontSize: 13, fontFamily: "IBM Plex Mono" }} domain={[0, 70]} axisLine={{ stroke: "rgba(237,234,227,0.2)" }} />
                <Tooltip
                  formatter={(val, name, item) => [
                    `${val}% BSI (${item.payload.suppliersWithGaps} of ${item.payload.suppliers} suppliers have gaps)`,
                    "Blind Spot",
                  ]}
                  contentStyle={{
                    background: COLOR.ink,
                    borderColor: COLOR.hairlineStrong,
                    color: COLOR.concrete,
                    fontSize: "14px",
                    borderRadius: "4px",
                  }}
                />
                <Bar dataKey="bsi" radius={[4, 4, 0, 0]}>
                  {tierData.map((entry, index) => {
                    const isWorst = entry.bsi === maxBsi && entry.bsi > 0;
                    return (
                      <Cell
                        key={`cell-${index}`}
                        fill={isWorst ? COLOR.rustBright : "#4A7C74"}
                        stroke={isWorst ? "#FFF" : "transparent"}
                        strokeWidth={isWorst ? 1.5 : 0}
                      />
                    );
                  })}
                </Bar>
              </BarChart>
            </ResponsiveContainer>
          </div>
        </div>
      </div>
    </div>
  );
}

