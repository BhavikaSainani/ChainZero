      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(360px, 1fr))", gap: "20px" }}>
        {/* Card 1: Material Substitution */}
        <div className="cad-panel" style={{ padding: "20px 24px", display: "flex", flexDirection: "column", justifyContent: "space-between" }}>
          <div>
            <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "12px" }}>
              <span style={{ fontSize: "15px", fontWeight: 700, color: COLOR.ink }}>
                1. Material Closed-Loop Swap
              </span>
              {materialAlt ? (
                <span style={{ fontSize: "13px", fontWeight: 700, color: COLOR.tealBright, background: "rgba(45,125,100,0.12)", padding: "2px 8px", borderRadius: "3px" }}>
