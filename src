function CircularSourcingHub({ nodes, alternatives, selectedSupplierId, onSelectSupplier }) {
  // Use selected supplier or fallback to top directTco2e node
  const activeSupplier = useMemo(() => {
    if (selectedSupplierId) {
      const found = nodes.find((n) => n.id === selectedSupplierId);
      if (found) return found;
    }
    return nodes[0] || null;
  }, [nodes, selectedSupplierId]);

  if (!activeSupplier) return null;

  // Match supplier material and transportMode against alternatives
  const materialAlt = (alternatives || []).find((a) => a.from === activeSupplier.material);
  const transportAlt = (alternatives || []).find((a) => a.from === activeSupplier.transportMode);

  // Compute Cat 1 and Cat 4 emissions from auditLines
  const cat1Line = (activeSupplier.auditLines || []).find((l) => l.category.includes("Cat 1") || l.category.includes("goods"));
  const cat4Line = (activeSupplier.auditLines || []).find((l) => l.category.includes("Cat 4") || l.category.includes("transport"));

  const cat1Emissions = cat1Line ? cat1Line.kgco2e / 1000 : activeSupplier.directTco2e * 0.6;
  const cat4Emissions = cat4Line ? cat4Line.kgco2e / 1000 : activeSupplier.directTco2e * 0.2;

  // Material Swap Calculations
  const matReductionPct = materialAlt ? materialAlt.reductionPct : 0;
  const matCurrentTonnes = cat1Emissions;
  const matProjectedTonnes = matCurrentTonnes * (1 - matReductionPct / 100);
  const matDelta = matCurrentTonnes - matProjectedTonnes;

  // Freight Swap Calculations
  const transReductionPct = transportAlt ? transportAlt.reductionPct : 0;
  const transCurrentTonnes = cat4Emissions;
  const transProjectedTonnes = transCurrentTonnes * (1 - transReductionPct / 100);
  const transDelta = transCurrentTonnes - transProjectedTonnes;

  const totalCurrent = matCurrentTonnes + transCurrentTonnes;
  const totalProjected = matProjectedTonnes + transProjectedTonnes;
  const totalAvoided = matDelta + transDelta;
  const overallReductionPct = totalCurrent > 0 ? (totalAvoided / totalCurrent) * 100 : 0;

  return (
    <div style={{ display: "flex", flexDirection: "column", gap: "24px" }}>
      {/* Disclaimer Banner - Modelled Projection */}
      <div
        style={{
          background: "linear-gradient(135deg, #1C1B18 0%, #2A2621 100%)",
          border: `1px solid ${COLOR.rustBright}`,
          borderRadius: "6px",
          padding: "20px 24px",
          color: COLOR.concrete,
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          flexWrap: "wrap",
          gap: "16px",
        }}
      >
        <div>
          <div style={{ display: "flex", alignItems: "center", gap: "10px" }}>
            <span style={{ fontSize: "13px", fontWeight: 700, letterSpacing: "0.08em", color: COLOR.rustBright, textTransform: "uppercase" }}>
              Circular Decarbonization Sandbox
            </span>
            <span
              style={{
                fontSize: "13px",
                fontWeight: 700,
                padding: "3px 10px",
                borderRadius: "3px",
                background: COLOR.amberLight,
                color: "#FFB800",
                border: "1px solid #FFB800",
              }}
            >
              PROJECTION (MODELLED POTENTIAL &middot; NOT MEASURED)
            </span>
          </div>
          <div style={{ fontSize: "18px", fontWeight: 700, marginTop: "6px" }}>
            Circular Sourcing Feasibility for {activeSupplier.name} ({activeSupplier.id})
          </div>
          <div style={{ fontSize: "14px", color: COLOR.concreteDim, marginTop: "4px" }}>
            Evaluating closed-loop material substitution and low-carbon freight modal shifts from static benchmarks.
          </div>
        </div>

        <div style={{ textAlign: "right", background: "rgba(168, 71, 31, 0.2)", padding: "12px 20px", borderRadius: "4px", border: `1px solid ${COLOR.rust}` }}>
          <div style={{ fontSize: "13px", color: COLOR.concreteDim, textTransform: "uppercase", fontWeight: 600 }}>Total Modelled Avoidance</div>
          <div style={{ fontSize: "28px", fontWeight: 800, color: COLOR.rustBright, fontFamily: "'IBM Plex Mono', monospace" }}>
            -{formatDec(totalAvoided, 2)} tCO2e
          </div>
          <div style={{ fontSize: "13px", color: COLOR.tealBright, fontWeight: 600 }}>
            {formatDec(overallReductionPct, 1)}% projected reduction
          </div>
        </div>
      </div>

      {/* Supplier Selector Quick Switcher */}
      <div className="cad-panel" style={{ padding: "16px 20px", display: "flex", alignItems: "center", gap: "14px", flexWrap: "wrap" }}>
        <span style={{ fontSize: "14px", fontWeight: 600, color: COLOR.ink }}>Selected Supplier:</span>
        <select
          value={activeSupplier.id}
          onChange={(e) => onSelectSupplier(e.target.value)}
          style={{
            padding: "8px 12px",
            fontSize: "14px",
            borderRadius: "4px",
            border: `1px solid ${COLOR.hairlineStrong}`,
