export default function CarbonAuditDashboard() {
  const [data, setData] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  const [activeTab, setActiveTab] = useState("overview"); // "overview" | "network" | "circular" | "ledger"
  const [selectedSupplierId, setSelectedSupplierId] = useState(null);
  const [auditModalOpen, setAuditModalOpen] = useState(false);

  const fetchData = () => {
    setLoading(true);
    setError(null);

    // Primary attempt: /dashboard.json
    fetch("/dashboard.json")
      .then((res) => {
        if (!res.ok) throw new Error(`HTTP ${res.status}: Failed to fetch /dashboard.json`);
        return res.json();
      })
      .then((json) => {
        setData(json);
        setLoading(false);
      })
      .catch((err) => {
        // Fallback attempt: relative dashboard.json
        fetch("dashboard.json")
          .then((res) => {
            if (!res.ok) throw new Error(`HTTP ${res.status}: Failed fallback fetch`);
            return res.json();
          })
          .then((json) => {
            setData(json);
            setLoading(false);
          })
          .catch((fallbackErr) => {
            setError(fallbackErr.message || err.message);
            setLoading(false);
          });
      });
  };

  useEffect(() => {
    fetchData();
  }, []);

  // Handle supplier selection and modal trigger
  const handleSelectSupplier = (supplierId) => {
    if (!supplierId) return;
    setSelectedSupplierId(supplierId);
    setAuditModalOpen(true);
  };

  if (loading) {
    return <LoadingSkeleton />;
  }

  if (error || !data) {
    return <ErrorDisplay message={error} onRetry={fetchData} />;
  }

  const { meta, totals, blindSpot, hotspots, nodes, edges, alternatives } = data;
  const selectedSupplier = nodes.find((n) => n.id === selectedSupplierId) || null;

  return (
    <div style={{ background: COLOR.concrete, minHeight: "100vh", fontFamily: "'IBM Plex Sans', sans-serif" }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Archivo+Expanded:wght@600;700;800&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap');
        * { box-sizing: border-box; }
        body { font-size: 14px; color: #211F1B; }
        input:focus, select:focus { outline: 2px solid ${COLOR.rust}; }
        button:focus-visible { outline: 2px solid ${COLOR.rust}; }

        .cad-header { padding: 24px 32px 0; background: ${COLOR.ink}; color: ${COLOR.concrete}; }
        .cad-main { padding: 24px 32px 48px; }
        .cad-panel { border: 1px solid ${COLOR.hairline}; background: ${COLOR.panel}; border-radius: 6px; }
        .cad-tab-active { border-bottom: 3px solid ${COLOR.rustBright} !important; color: #FFF !important; }
      `}</style>

      {/* Header & Hero */}
      <div className="cad-header">
        <div style={{ display: "flex", justifyContent: "space-between", alignItems: "flex-start", flexWrap: "wrap", gap: "16px" }}>
          <div>
            <div style={{ fontSize: "14px", letterSpacing: "0.1em", textTransform: "uppercase", color: COLOR.concreteDim, fontWeight: 600 }}>
              {meta ? meta.company : "Corporate Scope 3 Value Chain"} &middot; Auditable Supply Chain Accounting
            </div>
            <div style={{ fontFamily: "'Archivo Expanded', sans-serif", fontSize: "clamp(30px, 4vw, 48px)", fontWeight: 800, marginTop: "4px", lineHeight: 1.1 }}>
              {formatDec(totals.tco2e, 1)}
              <span style={{ fontSize: "clamp(16px, 2vw, 22px)", fontWeight: 600, color: COLOR.rustBright, marginLeft: "12px" }}>
                tCO2e Total
              </span>
            </div>
          </div>

          <div style={{ display: "flex", gap: "16px", alignItems: "center", flexWrap: "wrap" }}>
            <div style={{ background: "rgba(237,234,227,0.1)", padding: "10px 16px", borderRadius: "4px", border: `1px solid ${COLOR.hairlineOnDark}` }}>
              <div style={{ fontSize: "13px", color: COLOR.concreteDim, textTransform: "uppercase" }}>Suppliers & Relationships</div>
              <div style={{ fontSize: "16px", fontWeight: 700, fontFamily: "'IBM Plex Mono', monospace" }}>
                {meta ? meta.suppliers : nodes.length} Nodes &middot; {meta ? meta.relationships : edges.length} Links
              </div>
            </div>

            <div style={{ background: "rgba(237,234,227,0.1)", padding: "10px 16px", borderRadius: "4px", border: `1px solid ${COLOR.hairlineOnDark}` }}>
              <div style={{ fontSize: "13px", color: COLOR.concreteDim, textTransform: "uppercase" }}>Imputed Share</div>
              <div style={{ fontSize: "16px", fontWeight: 700, fontFamily: "'IBM Plex Mono', monospace", color: COLOR.rustBright }}>
                {(totals.imputedShare * 100).toFixed(1)}%
              </div>
            </div>
          </div>
        </div>

        {/* Section 2: Signature Blind Spot Panel */}
        <BlindSpotPanel blindSpot={blindSpot} />

        {/* Tab Navigation */}
        <div style={{ display: "flex", gap: "28px", borderTop: `1px solid ${COLOR.hairlineOnDark}`, marginTop: "16px" }}>
          {[
            { id: "overview", label: "Scope 3 Audit Overview" },
            { id: "network", label: `Value Chain Graph (${nodes.length} Nodes)` },
            { id: "circular", label: "Circular Sourcing Engine" },
            { id: "ledger", label: `Supplier Ledger (${nodes.length})` },
          ].map((tab) => (
            <button
              key={tab.id}
              onClick={() => setActiveTab(tab.id)}
              className={activeTab === tab.id ? "cad-tab-active" : ""}
              style={{
                background: "transparent",
                border: "none",
                borderBottom: "3px solid transparent",
                padding: "16px 4px",
                fontSize: "15px",
                fontWeight: 600,
                color: COLOR.concreteDim,
                cursor: "pointer",
                fontFamily: "'IBM Plex Sans', sans-serif",
                transition: "all 150ms ease",
              }}
            >
              {tab.label}
            </button>
          ))}
        </div>
      </div>

      {/* Main View Content */}
      <div className="cad-main">
        {/* Tab 1: Scope 3 Audit Overview */}
        {activeTab === "overview" && (
          <div style={{ display: "flex", flexDirection: "column", gap: "24px" }}>
            {/* Category KPI Cards Row */}
            <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(260px, 1fr))", gap: "18px" }}>
              {Object.entries(totals.byCategory || {}).map(([catName, catVal], i) => (
                <div key={i} className="cad-panel" style={{ padding: "20px 24px" }}>
                  <div style={{ fontSize: "13.5px", color: COLOR.inkMuted, fontWeight: 700, textTransform: "uppercase" }}>
                    {catName}
                  </div>
                  <div style={{ fontSize: "26px", fontWeight: 700, fontFamily: "'IBM Plex Mono', monospace", color: COLOR.ink, marginTop: "6px" }}>
                    {formatDec(catVal, 1)} tCO2e
                  </div>
                  <div style={{ fontSize: "14px", color: COLOR.inkMuted, marginTop: "4px" }}>
                    Share: <strong>{((catVal / totals.tco2e) * 100).toFixed(1)}%</strong> of total carbon footprint
                  </div>
                </div>
              ))}
            </div>

            {/* Top 10 Carbon Hotspots Table */}
            <div className="cad-panel" style={{ padding: "24px" }}>
              <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "16px" }}>
                <div>
                  <div style={{ fontSize: "16px", fontWeight: 700, color: COLOR.ink }}>
                    Priority Hotspot Suppliers (Top 10 Contributors)
                  </div>
                  <div style={{ fontSize: "14px", color: COLOR.inkMuted, marginTop: "2px" }}>
                    Directly responsible for the largest share of Scope 3 emissions. Click any row for audit trace.
                  </div>
                </div>
              </div>

              <div style={{ overflowX: "auto" }}>
                <table style={{ width: "100%", borderCollapse: "collapse", textAlign: "left", fontSize: "14px" }}>
                  <thead>
                    <tr style={{ borderBottom: `2px solid ${COLOR.hairlineStrong}`, background: COLOR.concreteDim }}>
                      <th style={{ padding: "12px 14px", color: COLOR.ink }}>ID</th>
                      <th style={{ padding: "12px 14px", color: COLOR.ink }}>Supplier Name</th>
                      <th style={{ padding: "12px 14px", color: COLOR.ink }}>Tier</th>
                      <th style={{ padding: "12px 14px", color: COLOR.ink }}>Direct tCO2e</th>
                      <th style={{ padding: "12px 14px", color: COLOR.ink }}>Share of Total</th>
                      <th style={{ padding: "12px 14px", color: COLOR.ink }}>Energy Status</th>
                      <th style={{ padding: "12px 14px", textAlign: "right", color: COLOR.ink }}>Action</th>
                    </tr>
                  </thead>
                  <tbody>
                    {(hotspots || []).map((h) => (
                      <tr
                        key={h.id}
                        onClick={() => handleSelectSupplier(h.id)}
                        style={{
                          borderBottom: `1px solid ${COLOR.hairline}`,
                          cursor: "pointer",
                          transition: "background 150ms ease",
                        }}
                      >
                        <td style={{ padding: "12px 14px", fontFamily: "'IBM Plex Mono', monospace", fontWeight: 700, color: COLOR.ink }}>
                          {h.id}
                        </td>
                        <td style={{ padding: "12px 14px", fontWeight: 600, color: COLOR.ink }}>{h.name}</td>
                        <td style={{ padding: "12px 14px", color: COLOR.ink }}>Tier {h.tier}</td>
                        <td style={{ padding: "12px 14px", fontFamily: "'IBM Plex Mono', monospace", fontWeight: 700, color: COLOR.rust }}>
                          {formatDec(h.directTco2e)}
                        </td>
                        <td style={{ padding: "12px 14px", fontFamily: "'IBM Plex Mono', monospace", color: COLOR.ink }}>
                          {(h.shareOfTotal * 100).toFixed(2)}%
                        </td>
                        <td style={{ padding: "12px 14px" }}>
                          <span
                            style={{
                              fontSize: "12px",
                              fontWeight: 700,
                              padding: "3px 8px",
                              borderRadius: "3px",
                              background: h.energyImputed ? COLOR.amberLight : "rgba(45,125,100,0.12)",
                              color: h.energyImputed ? COLOR.rustBright : COLOR.tealBright,
                              border: `1px solid ${h.energyImputed ? COLOR.rust : COLOR.tealBright}`,
                            }}
                          >
                            {h.energyImputed ? "IMPUTED" : "REPORTED"}
                          </span>
                        </td>
                        <td style={{ padding: "12px 14px", textAlign: "right" }}>
                          <button
                            onClick={(e) => {
                              e.stopPropagation();
                              handleSelectSupplier(h.id);
                            }}
                            style={{
                              fontSize: "13px",
                              fontWeight: 600,
                              padding: "6px 12px",
                              background: COLOR.ink,
                              color: COLOR.concrete,
                              border: "none",
                              borderRadius: "3px",
                              cursor: "pointer",
                            }}
                          >
                            Audit Lines &rarr;
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        )}

        {/* Tab 2: Value Chain Graph (200 Nodes) */}
        {activeTab === "network" && (
          <MultiTierFlowVisualizer
            nodes={nodes}
            edges={edges}
            onSelectSupplier={handleSelectSupplier}
            selectedSupplierId={selectedSupplierId}
          />
        )}

        {/* Tab 3: Circular Sourcing Hub */}
        {activeTab === "circular" && (
          <CircularSourcingHub
            nodes={nodes}
            alternatives={alternatives}
            selectedSupplierId={selectedSupplierId}
            onSelectSupplier={handleSelectSupplier}
          />
        )}

        {/* Tab 4: Auditable Supplier Ledger */}
        {activeTab === "ledger" && (
          <div className="cad-panel" style={{ padding: "24px", height: "680px" }}>
            <SupplierLedger
              nodes={nodes}
              onSelectSupplier={handleSelectSupplier}
              selectedSupplierId={selectedSupplierId}
            />
          </div>
        )}
      </div>

      {/* Section 1: Modal Audit Drill-Down */}
      <AuditProvenanceModal
        supplier={selectedSupplier}
        isOpen={auditModalOpen}
        onClose={() => setAuditModalOpen(false)}
      />
    </div>
  );
}
