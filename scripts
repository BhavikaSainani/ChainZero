"""
Builds ONE file, data/dashboard.json, that the frontend reads directly.

With a deadline today, this is the fastest safe architecture: no API server,
no CORS, no cold start. The React app fetches this static file. If time
allows later, the same shape can be served by FastAPI unchanged.

Run:  python build_dashboard_json.py
"""

import csv, json
from collections import defaultdict

suppliers = {r["supplier_id"]: r for r in csv.DictReader(open("data/suppliers.csv"))}
activity = {r["supplier_id"]: r for r in csv.DictReader(open("data/supplier_activity.csv"))}
edges = list(csv.DictReader(open("data/supplier_edges.csv")))
fps = {f["supplier_id"]: f for f in json.load(open("data/footprints_imputed.json"))}
bsi = json.load(open("data/blind_spot.json"))

# --- propagate emissions upward through the graph -------------------------
children = defaultdict(list)          # parent -> [(child, share)]
for e in edges:
    children[e["parent_id"]].append((e["child_id"], float(e["allocation_share"])))

memo = {}
def rollup(node):
    """Total = own direct emissions + allocated share of everything beneath."""
    if node in memo:
        return memo[node]
    direct = fps[node]["direct_kgco2e"] if node in fps else 0.0
    total = direct + sum(rollup(c) * share for c, share in children[node])
    memo[node] = total
    return total

company_total = rollup("FOCAL")

nodes = []
for sid, sup in suppliers.items():
    f = fps[sid]
    nodes.append({
        "id": sid,
        "name": sup["name"],
        "tier": int(sup["tier"]),
        "country": sup["country"],
        "reports": sup["reports_data"] == "yes",
        "energyImputed": f["energy_imputed"],
        "material": activity[sid]["material_type"],
        "massKg": float(activity[sid]["material_mass_kg"]),
        "transportMode": activity[sid]["transport_mode"],
        "spendUsd": float(activity[sid]["annual_spend_usd"]),
        "directTco2e": round(f["direct_kgco2e"] / 1000, 2),
        "rolledUpTco2e": round(rollup(sid) / 1000, 2),
        "shareOfTotal": round(f["direct_kgco2e"] / (company_total or 1), 5),
        "auditLines": f["lines"],
    })

nodes.sort(key=lambda n: -n["directTco2e"])

by_category = defaultdict(float)
for f in fps.values():
    for line in f["lines"]:
        if line["kgco2e"]:
            by_category[line["category"]] += line["kgco2e"] / 1000

payload = {
    "meta": {
        "company": "Modelled manufacturer, FY2025",
        "note": "Synthetic supply chain for prototype demonstration.",
        "suppliers": len(nodes),
        "relationships": len(edges),
    },
    "totals": {
        "tco2e": round(company_total / 1000, 1),
        "byCategory": {k: round(v, 1) for k, v in sorted(by_category.items())},
        "imputedShare": round(
            sum(n["directTco2e"] for n in nodes if n["energyImputed"]) /
            sum(n["directTco2e"] for n in nodes), 4),
    },
    "blindSpot": {
        "index": bsi["blind_spot_index"],
        "band": bsi["band"],
        "lineCoverage": bsi["line_coverage"],
        "byTier": bsi["by_tier"],
        "worstOffenders": bsi["worst_offenders"][:5],
    },
    "hotspots": [
        {k: n[k] for k in ("id", "name", "tier", "directTco2e", "shareOfTotal", "energyImputed")}
        for n in nodes[:10]
    ],
    "edges": [{"from": e["child_id"], "to": e["parent_id"],
               "share": float(e["allocation_share"])} for e in edges],
    "nodes": nodes,
    "alternatives": [
        {"from": "virgin_aluminium", "to": "recycled_aluminium", "reductionPct": 87.6},
        {"from": "virgin_steel", "to": "recycled_steel", "reductionPct": 71.5},
        {"from": "virgin_plastic_pet", "to": "recycled_plastic_pet", "reductionPct": 67.9},
        {"from": "air_freight", "to": "sea_freight", "reductionPct": 97.3},
    ],
}

json.dump(payload, open("data/dashboard.json", "w"), indent=1)
print(f"total {payload['totals']['tco2e']:,.0f} tCO2e | "
      f"{len(nodes)} nodes | {len(edges)} edges | "
      f"BSI {payload['blindSpot']['index']:.1%}")
print("wrote data/dashboard.json")
